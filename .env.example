# Ollama must remain bound to this machine's loopback interface.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=granite4.1:3b
OLLAMA_VERIFY_MODEL=
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=180
LLM_TEMPERATURE=0.0

# Local storage
VECTOR_STORE=chroma
VECTOR_STORE_PATH=./storage/vectorstore
DOCUMENTS_PATH=./data/raw

# Retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MIN_RELEVANCE_SCORE=0.65

# File parsing limits
MAX_FILE_BYTES=26214400
MAX_EXTRACTED_CHARS=5000000
MAX_PDF_PAGES=1000
PARSER_TIMEOUT_SECONDS=30
LOCAL_OCR=true
OCR_LANGUAGE=eng

# Map OS account names to groups. Mapped accounts also receive public access.
ACL_PRINCIPALS_JSON={}

# Privacy-protected features must remain disabled.
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
ALLOW_WEB_SEARCH=false
ALLOW_EXTERNAL_LLM=false
LOG_PROMPTS=false